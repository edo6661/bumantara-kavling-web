                    <td className="p-3">
                      <div className="flex items-center justify-center gap-1.5">

                        {/* 👇 1. JIKA STATUS MENUNGGU KONFIRMASI (Tampilkan Tombol Approve) 👇 */}
                        {c.status === 'MENUNGGU_KONFIRMASI' ? (
                          <>
                            {canApprovePayment ? (
                              <>
                                <button
