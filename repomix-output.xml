                        </td>
                        <td className={`${tdParentClass} text-center`}>
                          {group.menungguCount > 0 ? (
                            <span className="inline-flex px-2.5 py-1 text-[10px] font-bold uppercase bg-amber-100 text-amber-800 rounded-md">
                              {group.menungguCount}
