          id: t.id.toString(),
          nama: t.pembayaran,
          nominal: Number(t.nominal),
          tanggal: t.createdAt || t.updatedAt || item.tanggal
        }));
      setHistoryBiayaTambahan(existingTambahan);

      const existingTambahanKpr = Array.isArray(item.tambahanKpr) ? item.tambahanKpr : [];
