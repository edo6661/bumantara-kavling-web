        </form>
      </Modal>
    </div >
  );
};

const SectionTitle = ({ title }: { title: string }) => (
  <h4 className="text-xs font-bold text-slate-400 uppercase tracking-widest mb-3 border-b border-slate-100 pb-3 md:col-span-2 mt-4">{title}</h4>
);

